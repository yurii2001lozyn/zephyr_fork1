#include <zephyr/dt-bindings/gpio/gpio.h>

/* This board is PSOC6/CAT1A: ifx_cat1_spi_transfer_async() takes the
 * Cy_SCB_SPI_Transfer_Buffer() path (IFX_SPI_ASYMM_PDL_FUNC_AVAIL), not the
 * PSOC4 manual-chunking path the original slave-role bug was found in. This
 * overlay lets the same slave sample check whether the problem also shows
 * up on that different driver path.
 *
 * SCB3 has no pre-generated SPI pinctrl nodes (only I2C/UART), so its pins
 * are hand-defined below. SCB3 doubles as the board's default I2C bus
 * (i2c3); this overlay repurposes it for SPI slave mode instead. Slave mode
 * needs the hardware slave-select line (P6.3), since the generic GPIO CS
 * used by the master sample does not apply here.
 *
 * Logic-analyzer / external-master probe points:
 *   MOSI -> P6.0
 *   MISO -> P6.1
 *   SCLK -> P6.2
 *   CS   -> P6.3 (hardware slave select, active low)
 *
 * Only LED0 exists on this board, so LED1 (activity) and the sig0/sig1
 * logic-analyzer markers are mapped to spare P9 pins instead of real LEDs.
 */

spi1: &scb3 {
	compatible = "infineon,spi";
	status = "okay";

	pinctrl-0 = <&p6_0_scb3_spi_s_mosi &p6_1_scb3_spi_s_miso
		     &p6_2_scb3_spi_s_clk &p6_3_scb3_spi_s_select0>;
	pinctrl-names = "default";
};

&pinctrl {
	p6_0_scb3_spi_s_mosi: p6_0_scb3_spi_s_mosi {
		pinmux = <DT_CAT1_PINMUX(6, 0, HSIOM_SEL_ACT_8)>;
		input-enable;
	};

	p6_1_scb3_spi_s_miso: p6_1_scb3_spi_s_miso {
		pinmux = <DT_CAT1_PINMUX(6, 1, HSIOM_SEL_ACT_8)>;
		drive-push-pull;
	};

	p6_2_scb3_spi_s_clk: p6_2_scb3_spi_s_clk {
		pinmux = <DT_CAT1_PINMUX(6, 2, HSIOM_SEL_ACT_8)>;
		input-enable;
	};

	p6_3_scb3_spi_s_select0: p6_3_scb3_spi_s_select0 {
		pinmux = <DT_CAT1_PINMUX(6, 3, HSIOM_SEL_ACT_8)>;
		input-enable;
		bias-pull-up;
	};
};

/ {
	leds {
		activity_led: activity_led {
			gpios = <&gpio_prt9 0 GPIO_ACTIVE_HIGH>;
		};
	};

	debug_signals {
		compatible = "gpio-leds";
		status = "okay";

		sig_read: sig_read {
			gpios = <&gpio_prt9 1 GPIO_ACTIVE_HIGH>;
		};

		sig_ret: sig_ret {
			gpios = <&gpio_prt9 2 GPIO_ACTIVE_HIGH>;
		};
	};

	aliases {
		led1 = &activity_led;
		sig0 = &sig_read;
		sig1 = &sig_ret;
	};
};
